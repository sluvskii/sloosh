<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    tools:context=".ui.home.HomeFragment">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/main_blur_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/watch_history_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:listitem="@layout/item_movie_card"/>

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

    </eightbitlab.com.blurview.BlurTarget>

    <View
        android:id="@+id/top_scrim"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/top_gradient_scrim" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/toggle_container"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp">

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/top_blur_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <FrameLayout
            android:id="@+id/toggle_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp">

            <View
                android:id="@+id/slider_view"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_toggle_slider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/films_text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/sf_pro_family"
                    android:gravity="center"
                    android:text="Фильмы"
                    android:textColor="?attr/textPrimaryColor"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/series_text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/sf_pro_family"
                    android:gravity="center"
                    android:text="Сериалы"
                    android.textColor="?attr/textPrimaryColor"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/home_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="@color/brand_yellow_green"
        app:indicatorSize="48dp"
        app:trackThickness="5dp"
        app:trackCornerRadius="5dp"
        app:indeterminateAnimationType="disjoint"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/load_more_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="96dp"
        android:indeterminate="true"
        app:indicatorColor="@color/brand_yellow_green"
        app:indicatorSize="48dp"
        app:trackThickness="5dp"
        app:trackCornerRadius="5dp"
        app:indeterminateAnimationType="disjoint"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/error_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ошибка загрузки"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="18sp" />

        <Button
            android:id="@+id/try_again_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Попробовать снова" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/scroll_to_top_card"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="96dp"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        tools:visibility="visible">

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/scroll_to_top_blur"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/scroll_to_top_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/scroll_to_top"
                android:src="@drawable/ic_arrow_upward"
                app:tint="?attr/colorAccent" />
        </eightbitlab.com.blurview.BlurView>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>