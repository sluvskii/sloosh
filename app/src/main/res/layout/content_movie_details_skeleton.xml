<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/movie_poster_placeholder"
        android:layout_width="180dp"
        android:layout_height="270dp"
        android:layout_marginTop="80dp"
        android:background="@drawable/rounded_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

    <View
        android:id="@+id/movie_title_placeholder"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/rounded_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/movie_poster_placeholder" />

    <View
        android:id="@+id/watch_button_placeholder"
        style="@style/Widget.Material3.Button"
        android:layout_width="150dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_button_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/movie_title_placeholder" />

    <LinearLayout
        android:id="@+id/info_section_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/watch_button_placeholder">

        <View
            android:layout_width="50dp"
            android:layout_height="35dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/rounded_placeholder" />

        <View
            android:layout_width="50dp"
            android:layout_height="35dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/rounded_placeholder" />

        <View
            android:layout_width="50dp"
            android:layout_height="35dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/rounded_placeholder" />

        <View
            android:layout_width="50dp"
            android:layout_height="35dp"
            android:background="@drawable/rounded_placeholder" />
    </LinearLayout>

    <View
        android:id="@+id/release_date_label_placeholder"
        android:layout_width="100dp"
        android:layout_height="20dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/rounded_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info_section_placeholder" />

    <View
        android:id="@+id/country_label_placeholder"
        android:layout_width="60dp"
        android:layout_height="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/release_date_label_placeholder" />

    <View
        android:id="@+id/director_label_placeholder"
        android:layout_width="80dp"
        android:layout_height="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/country_label_placeholder" />

    <View
        android:id="@+id/description_label_placeholder"
        android:layout_width="120dp"
        android:layout_height="28dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/rounded_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/director_label_placeholder" />

    <View
        android:id="@+id/description_line_1"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/rounded_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description_label_placeholder" />

    <View
        android:id="@+id/description_line_2"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/rounded_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description_line_1" />

    <View
        android:id="@+id/comments_button_placeholder"
        android:layout_width="180dp"
        android:layout_height="24dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/rounded_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description_line_2" />

</androidx.constraintlayout.widget.ConstraintLayout>